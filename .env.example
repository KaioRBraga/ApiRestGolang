# ---------------------------------------------------------------------------
# Environment configuration
#
# Consumed by Docker Compose, which injects these values into the go_app and
# go_db containers. The application reads them at runtime via os.Getenv in
# db/conn.go.
#
# Template file, safe to commit. Copy it to .env and set real values.
#
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_PORT=8000

# --- Database --------------------------------------------------------------
# DB_HOST is the Compose service name of the database container. When running
# the application directly on the host with `go run`, set it to localhost.
DB_HOST=go_db
DB_PORT=5432

# Port published on the host for direct access to PostgreSQL. Change this if
# 5432 is already in use locally; it does not affect the in-network port.
DB_HOST_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=postgres
